    "category":  "recruitable",
    "position":  { "x": 17, "y": 10 },
    "direction": "down",
    "behavior":  "idle",
    "dialogue":  ["……瞿先生。", "茶桌散了以後，我們最好別在街上講話。"],
    "variants": [
      {
        "if": "ws_end_camp",
        "dialogue": [
